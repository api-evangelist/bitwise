          "name": "Get ETF",
          "request": {
            "name": "Get ETF",
            "description": {
              "content": "Retrieves ETF data for a specified fund symbol and optional date. If no date is provided it defaults to the current date and returns comprehensive fund information including pricing, holdings, and metadata.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "etf",
                ":etfName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<date>",
                  "description": "As-of date (YYYY-MM-DD); defaults to today."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "etfName",
                  "description": "(Required) ETF ticker symbol (e.g. BITB)."
                }
              ]
