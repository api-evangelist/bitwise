  "info": {
    "_postman_id": "2ac6304f-e7b7-42df-8b47-fd6dd985949d",
    "name": "Bitwise ETFs API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Read-only market-data API for Bitwise indexes, ETFs, and fund data. Returns index metadata, historical daily index values, index constituents with prices/supplies/weights, per-fund data (market price, NAV, AUM, holdings, crypto-per-share, performance), and ETF listings and details. Endpoints and the authentication model are derived from the provider's published Postman collection at https://developers.bitwiseinvestments.com/; base host and error envelope were confirmed by live probe of https://api.bitwiseinvestments.com.\n\nContact Support:\n Name: Bitwise API Support\n Email: api@bitwiseinvestments.com",
      "type": "text/plain"
    }
  }
