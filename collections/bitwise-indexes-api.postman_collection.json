        {
          "id": "79c2f044-12cb-439d-a1be-71e9c51f1f75",
          "name": "Get index constituents",
          "request": {
            "name": "Get index constituents",
            "description": {
              "content": "Returns current and past index information including index value and constituent assets with their prices, supplies, and weights. A timestamp may be supplied to retrieve data from a particular point in time; omit it to receive the most recent available data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "indexes",
                ":indexName",
                "constituents"
